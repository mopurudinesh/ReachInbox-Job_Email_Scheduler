{
  "name": "reachinbox-scheduler",
  "version": "1.0.0",
  "private": true,
  "description": "Full-Stack Production Email Scheduling Application",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "infra:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker-compose.yml down",
    "infra:logs": "docker compose -f infrastructure/docker-compose.yml logs -f",
    "build:shared": "npm run build --workspace=@reachinbox/shared",
    "build:backend": "npm run build:shared && npm run build --workspace=@reachinbox/api && npm run build --workspace=@reachinbox/worker",
    "build": "npm run build:shared && npm run build --workspaces --if-present",
    "start": "node apps/api/dist/app.js",
    "start:all": "concurrently \"node apps/api/dist/app.js\" \"node apps/worker/dist/index.js\"",
    "dev:shared": "npm run dev --workspace=@reachinbox/shared",
    "dev:api": "npm run dev --workspace=@reachinbox/api",
    "dev:worker": "npm run dev --workspace=@reachinbox/worker",
    "dev:web": "npm run dev --workspace=@reachinbox/web",
    "dev": "npm run build:shared && concurrently -n \"shared,api,worker,web\" -c \"magenta,blue,green,cyan\" \"npm:dev:shared\" \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:web\"",
    "db:generate": "npm run db:generate --workspace=@reachinbox/api",
    "db:migrate": "npm run db:migrate --workspace=@reachinbox/api",
    "db:deploy": "npm run db:deploy --workspace=@reachinbox/api",
    "db:studio": "npm run db:studio --workspace=@reachinbox/api",
    "search:reindex": "npm run search:reindex --workspace=@reachinbox/api",
    "test": "npm run test --workspaces --if-present"
  },
  "dependencies": {
    "concurrently": "^9.1.2"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  }
}
