# ==============================================================================
# ReachInbox Email Scheduler - Local Development Environment Variables
# Copy this file to .env before starting the application:
#   copy .env.example .env
# ==============================================================================

# Application Ports & URLs
NODE_ENV=development
API_PORT=4000
WEB_PORT=5173
API_URL=http://localhost:4000
WEB_URL=http://localhost:5173

# Database (PostgreSQL via Docker Compose)
DATABASE_URL=postgresql://reachinbox_user:reachinbox_pass@localhost:5432/reachinbox_db?schema=public

# Cache & Queues (Redis via Docker Compose)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Search Engine (Elasticsearch via Docker Compose)
ELASTICSEARCH_NODE=http://localhost:9200

# Ethereal SMTP test account (never a real-recipient delivery service)
ETHEREAL_SMTP_HOST=smtp.ethereal.email
ETHEREAL_SMTP_PORT=587
ETHEREAL_SMTP_SECURE=false
ETHEREAL_SMTP_USER=your_ethereal_username
ETHEREAL_SMTP_PASSWORD=your_ethereal_password


# Server-Side Session Security
# Generate a unique random value of at least 32 characters before running the API:
SESSION_SECRET=replace_with_random_secret_at_least_32_characters

# Google OAuth 2.0 Credentials
# Obtain from Google Cloud Console > APIs & Services > Credentials
# Authorized redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Slack OAuth Credentials & Webhook Settings
# Obtain from Slack API Console: https://api.slack.com/apps
# Scopes needed: chat:write, incoming-webhook
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_REDIRECT_URI=http://localhost:4000/api/integrations/slack/callback
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=replace_with_base64_encoded_32_random_bytes

# BullMQ Queue & Worker Configuration
WORKER_CONCURRENCY=5
DEFAULT_HOURLY_LIMIT=50
DEFAULT_DELAY_BETWEEN_EMAILS_SECONDS=2

# Bull Board Dashboard Security
# Basic auth credentials for accessing queue monitoring at /admin/queues
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=your_unique_dashboard_password
